{
  "name": "dg20-form-builder",
  "private": true,
  "version": "0.0.0",
  "description": "DG 2.0 Form Builder workspace — Form Definition contract, controlled palette, renderer, and Builder SPA foundations",
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "vitest run",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "clean": "npm run clean --workspaces --if-present && rm -rf node_modules",
    "storybook": "npm run storybook -w @dg20/form-widgets",
    "storybook:build": "npm run storybook:build -w @dg20/form-widgets",
    "dev:builder": "npm run dev -w @dg20/form-builder-app",
    "build:builder": "npm run build -w @dg20/form-builder-app",
    "preview:builder": "npm run preview -w @dg20/form-builder-app",
    "pack:builder-embed": "node scripts/pack-builder-embed.mjs",
    "verify:builder-embed": "node scripts/verify-builder-embed-pack.mjs",
    "e4:verify": "node scripts/e4-technical-e2e.mjs",
    "e4:export-fixture": "vite-node --script acceptance/unit-e/export-representative-fixture.mjs",
    "e5.1:verify": "node scripts/e5.1-fds-container-smoke.mjs",
    "e5.2:verify": "node scripts/e5.2-helm-render-verify.mjs",
    "e5.3a:verify": "node scripts/e5.3a-portal-proxy-verify.mjs",
    "e5.5.1:verify": "node scripts/e5.5.1-image-supply-chain.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/node": "^22.15.21",
    "@vitejs/plugin-react": "^4.5.2",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.2.0",
    "prettier": "^3.5.3",
    "typescript": "^5.8.3",
    "typescript-eslint": "^8.33.0",
    "vite": "^6.3.5",
    "vitest": "^3.1.4"
  }
}
