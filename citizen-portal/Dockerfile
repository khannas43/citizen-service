FROM node:20-alpine AS builder
WORKDIR /app
COPY package*.json ./
COPY vendor ./vendor
RUN npm ci
COPY . .

ARG VITE_CASTE_API
ARG VITE_MARRIAGE_API
ARG VITE_PENSION_API
ARG VITE_FAMILY_MB_API
ARG VITE_SCHEME_APP_API
ARG VITE_FAMILY_API
ARG VITE_SCHEME_API
ARG VITE_AUTH_API
ARG VITE_CHATBOT_API
ARG VITE_GRIEVANCE_API
ARG VITE_NOTIFICATIONS_API
ARG VITE_OFFICER_PORTAL_URL
ARG VITE_AI_BASE
ENV VITE_CASTE_API=$VITE_CASTE_API
ENV VITE_MARRIAGE_API=$VITE_MARRIAGE_API
ENV VITE_PENSION_API=$VITE_PENSION_API
ENV VITE_FAMILY_MB_API=$VITE_FAMILY_MB_API
ENV VITE_SCHEME_APP_API=$VITE_SCHEME_APP_API
ENV VITE_FAMILY_API=$VITE_FAMILY_API
ENV VITE_SCHEME_API=$VITE_SCHEME_API
ENV VITE_AUTH_API=$VITE_AUTH_API
ENV VITE_CHATBOT_API=$VITE_CHATBOT_API
ENV VITE_GRIEVANCE_API=$VITE_GRIEVANCE_API
ENV VITE_NOTIFICATIONS_API=$VITE_NOTIFICATIONS_API
ENV VITE_OFFICER_PORTAL_URL=$VITE_OFFICER_PORTAL_URL
ENV VITE_AI_BASE=$VITE_AI_BASE
RUN npm run build

FROM nginx:alpine
COPY --from=builder /app/dist /usr/share/nginx/html
COPY nginx.conf /etc/nginx/conf.d/default.conf
COPY nginx/form-definition-service-location.conf.template /etc/nginx/templates/form-definition-service-location.conf.template
RUN mkdir -p /etc/nginx/form-definition-service
ENV FORM_DEFINITION_SERVICE_UPSTREAM=http://form-definition-service:8080
ENV NGINX_ENVSUBST_FILTER=^FORM_DEFINITION_SERVICE_UPSTREAM$
ENV NGINX_ENVSUBST_OUTPUT_DIR=/etc/nginx/form-definition-service
EXPOSE 80
