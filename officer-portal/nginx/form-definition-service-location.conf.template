# Deny everything else under the FDS prefix (actuator, technical drafts/lifecycle, published/latest, etc.).
location = /form-definition-service {
    add_header Cache-Control "no-store" always;
    default_type application/json;
    return 403 '{"code":"fds_proxy_forbidden"}';
}

location /form-definition-service/ {
    add_header Cache-Control "no-store" always;
    default_type application/json;
    return 403 '{"code":"fds_proxy_forbidden"}';
}
