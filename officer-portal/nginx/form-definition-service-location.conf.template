# FB-E5.3A.1 / FB-E5.4.3B — least-privilege Form Definition Service proxy (officer).
# Runtime: FORM_DEFINITION_SERVICE_UPSTREAM (default http://form-definition-service:8080)
# Allows exact governance + authenticated Builder API method/path combinations only.
# All other FDS paths/methods are rejected locally (including published/latest and technical APIs).
# nginx forwards credentials when present but does not authenticate.
# FDS remains authoritative for 401/403. Governance stays fail-closed without a valid FDS principal.
# This proxy does not enable governance-technical.

# Exact allow — query string preserved by nginx when proxy_pass URI has no '?'.

# --- Governance (FB-E5.3A.1) ---
location = /form-definition-service/api/v1/form-definitions/governance/queue {
    if ($request_method != GET) {
        return 405;
    }

    proxy_pass ${FORM_DEFINITION_SERVICE_UPSTREAM}/form-definition-service/api/v1/form-definitions/governance/queue;
    proxy_http_version 1.1;

    proxy_set_header Host $host;
    proxy_set_header X-Real-IP $remote_addr;
    proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Forwarded-Host $host;

    proxy_set_header Authorization $http_authorization;
    proxy_set_header If-Match $http_if_match;

    proxy_pass_header ETag;
    proxy_hide_header Cache-Control;
    add_header Cache-Control "no-store" always;

    proxy_connect_timeout 10s;
    proxy_send_timeout 60s;
    proxy_read_timeout 60s;

    access_log off;
}

